-static unsigned long timestamp(int init)
-{
-  struct timeval now, delta;
-  struct timezone tz;
-  static struct timeval first;
-
-  if (init) {
-    gettimeofday(&first, &tz);
-
-    return(0);
-  } else {
-    gettimeofday(&now, &tz);
-    timersub(&now, &first, &delta);
-
-    return((long)(1 + ((1000 * delta.tv_sec) + delta.tv_usec/1000)));
-  }
-}
