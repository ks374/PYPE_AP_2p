+		"""
+		import time as T
+		t = dacq_ts()
+		if not self.config.iget('DACQ_TESTMODE'):
+		#this is causing a wedge!!!
+		    dacq_str_word(pype_plex_code_dict(code))## Write the strobed word
+		return t
