+		# stop eye recording, just in case user forgot.
+		self.eyetrace(0)
+
+		n = dacq_adbuf_size()
+		self.eyebuf_t = zeros(n)
+		self.eyebuf_x = zeros(n)
+		self.eyebuf_y = zeros(n)
+		self.eyebuf_pa = zeros(n)
+		p0 = zeros(n)
+		s0 = zeros(n)
+		if self.rig_common.queryv('save_chn_0'):
