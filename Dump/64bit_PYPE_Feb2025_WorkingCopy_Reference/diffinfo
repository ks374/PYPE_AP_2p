-void dacq_dig_out(int n, int val)
-{
-  int i;
-  /* wait for strobe to be clear */
-  do {
-    LOCK(semid);
-    i = dacq_data->dout_strobe;
-    UNLOCK(semid);
-    usleep(100);
-  } while (i);
-
-  LOCK(semid);  
-  dacq_data->dout[n] = val ? 1 : 0;
